# Credenciais do AirView ResMed
AIRVIEW_USER=seu_usuario_aqui
AIRVIEW_PASS=sua_senha_aqui

# Chave da API OpenAI (obtenha em https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Login da aplicação web (OBRIGATÓRIO ao publicar na internet).
# Se ficarem em branco, a app roda SEM senha — use assim só localmente.
APP_USER=
APP_PASSWORD=

# Pasta de dados (banco + relatórios). Local: deixe em branco (usa a pasta atual).
# Na nuvem: aponte para o volume persistente, ex.: /data
APP_DATA_DIR=

# Configurações opcionais
HEADLESS=true
SLOW_MO=0
TIMEOUT_MS=30000
MAX_PATIENTS=10
REPORT_DAYS=14
DELAY_BETWEEN_PATIENTS=2
