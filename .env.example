# Credenciais do AirView ResMed
AIRVIEW_USER=seu_usuario_aqui
AIRVIEW_PASS=sua_senha_aqui

# Chave da API OpenAI (obtenha em https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# URL do MONITORAMENTO_CPAP_FAPS (Next.js) — local ou produção
NEXTJS_API_URL=http://localhost:3000

# Chave secreta compartilhada com o Next.js (mesma string configurada
# em AIRVIEW_SYNC_SECRET no .env.local do Next.js). Gere uma string
# aleatória forte, ex.: openssl rand -hex 32
AIRVIEW_SYNC_SECRET=

# Configurações opcionais
HEADLESS=true
SLOW_MO=0
TIMEOUT_MS=30000
